{
  "manifest_version": 3,
  "minimum_chrome_version": "106",
  "name": "PapAI Gardien",
  "version": "0.1.0",
  "description": "Un proche à vos côtés pour reconnaître les sites suspects.",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://papai-450417131702.europe-west1.run.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "gardien.js"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "PapAI Gardien",
    "default_icon": {"16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png"}
  },
  "icons": {"16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["page.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
